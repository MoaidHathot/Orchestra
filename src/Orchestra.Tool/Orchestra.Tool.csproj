<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Orchestra.Tool</RootNamespace>
    <PackageId>Orchestra</PackageId>
    <Description>Deterministic AI orchestrations for .NET with declarative workflows, DAG execution, MCP integration, triggers, and a built-in portal.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ToolCommandName>orchestra</ToolCommandName>

    <!--
      Ship the tool nupkg SMALL. Bundling the Copilot CLI for every supported RID
      pushed the package to ~342 MB (NuGet.org rejects >250 MB), and shipping only
      one RID re-creates the original bug where users on other OSes find no binary.

      Instead the tool fetches just the host's Copilot CLI on first run via
      Orchestra.Copilot.CopilotCliBootstrap, caching it in the user's local app
      data so subsequent runs are instant. CopilotSkipCliDownload=true keeps the
      SDK's per-host build-time download from baking the binary into the tool's
      publish output.
    -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orchestra.Engine\Orchestra.Engine.csproj" />
    <ProjectReference Include="..\Orchestra.Copilot\Orchestra.Copilot.csproj" />
    <ProjectReference Include="..\Orchestra.Host\Orchestra.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md"
          Link="README.md"
          Pack="true"
          PackagePath="\" />
    <Compile Include="..\..\playground\Hosting\Orchestra.Playground.Copilot.Portal\PortalApp.cs"
             Link="PortalApp.cs" />
    <Compile Include="..\..\playground\Hosting\Orchestra.Playground.Copilot.Portal\PortalStatusService.cs"
             Link="PortalStatusService.cs" />
    <Content Include="..\..\playground\Hosting\Orchestra.Playground.Copilot.Portal\appsettings.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
    <Content Include="..\..\playground\Hosting\Orchestra.Playground.Copilot.Portal\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
    <Content Include="..\..\schemas\*.json"
             Link="schemas\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
  </ItemGroup>

</Project>
