<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Orchestra web portal: the ASP.NET host that serves the React SPA plus the REST/SSE/MCP
    endpoints from Orchestra.Host. Consumed two ways:
      - `orchestra portal` (src/Orchestra.Cli references this project and copies wwwroot/),
      - `dotnet run` here for local development (Program.cs), which is also what the
        Orchestra.Portal.Tests WebApplicationFactory and the Playwright E2E fixture start.
  -->

  <PropertyGroup>
    <RootNamespace>Orchestra.Portal</RootNamespace>
    <AssemblyName>Orchestra.Portal</AssemblyName>
    <IsPackable>false</IsPackable>
    <SpaRoot>portal\</SpaRoot>
    <PortalBuildStamp>$(SpaRoot).build-stamp</PortalBuildStamp>
    <!-- The tool nupkg fetches the Copilot CLI on first run; never bake it into a build here. -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orchestra.Engine\Orchestra.Engine.csproj" />
    <ProjectReference Include="..\Orchestra.Copilot\Orchestra.Copilot.csproj" />
    <ProjectReference Include="..\Orchestra.OpenCode\Orchestra.OpenCode.csproj" />
    <ProjectReference Include="..\Orchestra.Host\Orchestra.Host.csproj" />
  </ItemGroup>

  <!-- Shared composition helper that registers every agent provider (copilot + opencode) as a
       keyed AgentBuilder plus the multi-provider AgentProviderRegistry. Compiled in (rather than
       referenced) because it is internal; mirrors Orchestra.Server / Orchestra.Cli. Without this
       the Portal would fall back to a SingleAgentProviderRegistry that ignores each step's
       `provider` and routes everything to one builder. -->
  <ItemGroup>
    <Compile Include="..\Shared\AgentProviderRegistration.cs" Link="Composition\AgentProviderRegistration.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orchestra.Cli" />
    <!-- Orchestra.Cli.Tests composes a host with AddOrchestraAgentProviders, which is internal here. -->
    <InternalsVisibleTo Include="Orchestra.Cli.Tests" />
    <InternalsVisibleTo Include="Orchestra.Portal.Tests" />
    <InternalsVisibleTo Include="Orchestra.Portal.E2E" />
  </ItemGroup>

  <!-- Collect portal source files for incremental build detection -->
  <ItemGroup>
    <Content Include="..\..\templates\*.yaml" Link="templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\builtins\*.json" Link="builtins\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\schemas\**\*.json" Link="schemas\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\skills\**\*.md" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PortalSourceFiles Include="$(SpaRoot)src\**\*" />
    <PortalSourceFiles Include="$(SpaRoot)package.json" />
    <PortalSourceFiles Include="$(SpaRoot)package-lock.json" />
    <PortalSourceFiles Include="$(SpaRoot)tsconfig.json" />
    <PortalSourceFiles Include="$(SpaRoot)vite.config.ts" />
    <PortalSourceFiles Include="$(SpaRoot)index.html" />
  </ItemGroup>

  <!-- Ensure node_modules are installed before build -->
  <Target Name="NpmInstall" BeforeTargets="BuildPortal" Condition="!Exists('$(SpaRoot)node_modules')">
    <Exec Command="npm install" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <!-- Build the Vite frontend before .NET build (output goes to wwwroot/).
       Uses Inputs/Outputs to skip rebuilding when no portal source files changed.
       Set SKIP_PORTAL_BUILD=true to skip entirely (CI test jobs, inner-loop .NET work). -->
  <Target Name="BuildPortal" BeforeTargets="Build"
          Condition="'$(SKIP_PORTAL_BUILD)' != 'true'"
          Inputs="@(PortalSourceFiles)"
          Outputs="$(PortalBuildStamp)">
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
    <Touch Files="$(PortalBuildStamp)" AlwaysCreate="true" />
  </Target>

  <!-- Exclude portal source from .NET content items -->
  <ItemGroup>
    <Content Remove="portal\**" />
    <None Include="portal\**" Exclude="portal\node_modules\**;portal\.build-stamp;portal\tsconfig.tsbuildinfo" />
  </ItemGroup>

</Project>
