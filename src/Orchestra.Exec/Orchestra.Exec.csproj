<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Orchestra.Exec</RootNamespace>
    <PackageId>Orchestra.Exec</PackageId>
    <Description>One-shot runner for Orchestra: boots an isolated in-process Orchestra host, runs a single orchestration (interactive HITL supported), then shuts down with a status exit code.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>orchestra-exec</ToolCommandName>

    <!--
      Like the Orchestra portal tool, fetch the Copilot CLI on first run rather than
      baking a per-RID binary into the package (keeps the nupkg small and cross-platform).
    -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orchestra.Engine\Orchestra.Engine.csproj" />
    <ProjectReference Include="..\Orchestra.Copilot\Orchestra.Copilot.csproj" />
    <ProjectReference Include="..\Orchestra.Host\Orchestra.Host.csproj" />
    <ProjectReference Include="..\Orchestra.Client\Orchestra.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orchestra.Exec.Tests" />
  </ItemGroup>

</Project>
