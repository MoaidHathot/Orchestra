<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Orchestra.Cli</RootNamespace>
    <PackageId>Orchestra</PackageId>
    <Description>Deterministic AI orchestrations for .NET with declarative workflows, DAG execution, MCP integration, triggers, a one-shot runner, and a built-in portal — all under a single `orchestra` command.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ToolCommandName>orchestra</ToolCommandName>

    <!--
      Ship the tool nupkg SMALL. Bundling the Copilot CLI for every supported RID
      pushed the package well over NuGet.org's 250 MB limit. Instead the tool fetches
      just the host's Copilot CLI on first run via Orchestra.Copilot.CopilotCliBootstrap,
      caching it in the user's local app data. CopilotSkipCliDownload=true keeps the SDK's
      per-host build-time download from baking the binary into the publish output.
    -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>

    <!--
      The portal's wwwroot is shipped as plain files copied into this project's output (see the
      Content items below) so `orchestra portal` can serve them from AppContext.BaseDirectory.
      With Orchestra.Portal referenced as a project, the Static Web Assets SDK would also try to
      flow the same files as static web assets and fail on duplicate keys; the plain copy is the
      mechanism we want, so disable the SWA pipeline here.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orchestra.Client\Orchestra.Client.csproj" />
    <ProjectReference Include="..\Orchestra.Engine\Orchestra.Engine.csproj" />
    <ProjectReference Include="..\Orchestra.Copilot\Orchestra.Copilot.csproj" />
    <ProjectReference Include="..\Orchestra.OpenCode\Orchestra.OpenCode.csproj" />
    <ProjectReference Include="..\Orchestra.Host\Orchestra.Host.csproj" />
    <!-- Portal host + UI (the `orchestra portal` subcommand). -->
    <ProjectReference Include="..\Orchestra.Portal\Orchestra.Portal.csproj" />
  </ItemGroup>

  <!--
    Keyed copilot + opencode provider registration (src/Shared/AgentProviderRegistration.cs) is
    compiled into Orchestra.Portal, which grants this project InternalsVisibleTo; compiling a second
    copy here would make AddOrchestraAgentProviders ambiguous.
  -->

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
    <Content Include="..\Orchestra.Portal\appsettings.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
    <!--
      The built SPA. A ProjectReference does not flow a Web project's wwwroot into the referencing
      exe's output, so copy it explicitly; Orchestra.Portal's BuildPortal target has produced it by
      the time this project builds because the reference orders the builds.
    -->
    <Content Include="..\Orchestra.Portal\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
    <Content Include="..\..\schemas\*.json"
             Link="schemas\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
    <!--
      Starter orchestrations scaffolded by `orchestra init`. Same publish-dir mechanism as
      schemas above: Pack=false keeps them out of the package root, while
      CopyToPublishDirectory puts them in the publish output that PackAsTool ships as
      tools/net10.0/any/templates/. Kept as real files (not embedded resources) so they
      stay editable, schema-validated in the editor, and coverable by BundledTemplatesTests.
    -->
    <Content Include="..\..\templates\*.yaml"
             Link="templates\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
    <!--
      The orchestration-authoring Agent Skill. Shipping it means a Prompt step can point
      `skillDirectories` at the copy `orchestra init` drops into a workspace, instead of the
      skill being reachable only by cloning the GitHub repo. ~135 KB of Markdown, so the size
      cost is negligible next to the portal assets.
    -->
    <Content Include="..\..\skills\**\*.md"
             Link="skills\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orchestra.Cli.Tests" />
    <InternalsVisibleTo Include="Orchestra.Exec.Tests" />
  </ItemGroup>

</Project>
